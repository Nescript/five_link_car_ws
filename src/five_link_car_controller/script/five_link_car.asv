%[text] ## **对轮组：**
syms N_f N m_wheel x(t) ddx
%[text] 其中 N\_f 是轮子所受摩擦力，N 是轮子对摆杆的力的水平分量，m\_wheel 是轮组质量，ddx 是轮组加速度
Eq1 = N_f - N == m_wheel * diff(x(t), t, 2) %[output:45d47723]
%[text] 上式是水平方向受力平衡
syms I_wheel domega T R
%[text] 其中 I\_wheel 是轮组的转动惯量，d\_omega 是轮组旋转角加速度，T 是我们的控制的轮组输出力矩，R 是轮组半径
Eq2 = I_wheel * domega == T - N_f * R %[output:992f71f7]
Eq2_sub = subs(Eq2, domega, ddx / R) %[output:8978ff1a]
Eq1_sub = subs(Eq1, diff(x(t), t, 2), ddx) %[output:50eeed9b]
%[text] 上式是转动定律
sol = solve([Eq1_sub, Eq2_sub], [ddx, N_f]) %[output:1581996e]
ddx_expr = simplify(sol.ddx) %[output:481fbc66]
Eq_wheel = ddx == ddx_expr %[output:23d8db96]
pretty(ddx_expr) %[output:84ffab55]
%[text] 由前面式子解得的**关于轮组加速度 ddx 的表达式**
%[text] ## **对摆杆：**
%[text] **水平方向有**
syms N_M m_P L theta(t)

pos_pendulum_x = x(t) + L * sin(theta(t)) %[output:440cfabf]
acc_pendulum_x = diff(pos_pendulum_x, t, 2) %[output:6ca0b1ab]
Eq1_pendulum = N - N_M == m_P * acc_pendulum_x %[output:04566835]
%[text] 其中：N\_M 是摆杆对机体力的水平分量，m\_P 是摆杆的质量，theta 是摆杆的倾角，L 是摆杆重心到轮组的距离
%[text] **竖直方向有**
syms P P_M g
pos_pendulum_y = L * cos(theta(t)) %[output:29574c0a]
acc_pendulum_y = diff(pos_pendulum_y, t, 2) %[output:7ca7ff1a]

Eq2_pendulum = P - P_M - m_P * g == m_P * acc_pendulum_y %[output:546b12a5]
%[text] **转动定律有**
syms I_P L_M T_P

Eq3_pendulum = I_P * diff(theta(t), t, 2) == (P * L + P_M * L_M) * sin(theta(t)) - (N * L + N_M * L_M) * cos(theta(t)) - T + T_P %[output:89507b56]
%[text] ## **对机体：**
%[text] **水平方向有**
syms phi(t) l M
pos_body_x = x(t) + (L + L_M) * sin(theta(t)) - l * sin(phi(t))  %[output:1a1eb107]
acc_body_x = diff(pos_body_x, t, 2) %[output:6c34397e]
Eq1_body = N_M == M * acc_body_x %[output:7528c4ab]
%[text] **竖直方向有**
pos_body_y = (L + L_M) * cos(theta(t)) + l * cos(phi(t)) %[output:4867be5c]
acc_body_y = diff(pos_body_y, t, 2) %[output:98ea306b]
Eq2_body = P_M - M * g == M * acc_body_y  %[output:131fadc1]
%[text] **转动定律有**
syms I_M
Eq3_body = I_M * diff(phi(t), t, 2) == -T_P + N_M * l * cos(phi(t)) + P_M * l * sin(phi(t)) %[output:4d2ee98a]
%[text] ## 联立消去相互作用力：
syms ddtheta dtheta ddphi
old_diff = [diff(x(t), t, 2), diff(theta(t), t, 2), diff(phi(t), t, 2)] %[output:5d3e4f93]
new_dd = [ddx, ddtheta, ddphi] %[output:99230eac]

force_solve = solve([Eq1_pendulum, Eq2_pendulum, Eq1_body, Eq2_body], [N_M, N, P, P_M]) %[output:78a1aa07]
N_M_expr = subs(force_solve.N_M, old_diff, new_dd) %[output:4b68375d]
N_expr = subs(force_solve.N, old_diff, new_dd) %[output:4f6cd981]
P_expr = subs(force_solve.P, old_diff, new_dd) %[output:40b7f439]
P_M_expr = subs(force_solve.P_M, old_diff, new_dd) %[output:5ba154e0]


old_vars = [N, N_M, P, P_M] %[output:1add8b3a]
new_vars = [N_expr, N_M_expr, P_expr, P_M_expr] %[output:457e5265]

% 这里消去相互作用力和微分项，为最终求解做准备

old_tot = [old_diff, old_vars] %[output:1f82bbb2]
new_tot = [new_dd, new_vars] %[output:473348ce]

% 检查这一步
% 这一步真是有问题，如果用old_diff和new_dd对Eq3_body去sub，I_M项会消失，所以下面散开来处理了
% 检验发现似乎是一阶导项的
Eq3_body %[output:24aedc74]
test = subs(Eq3_body, old_vars, new_vars) %[output:3e22c3e0]
test1 = subs(test, old_tot, new_tot) %[output:05e114ef]
Eq3_body_sub = subs(Eq3_body, [diff(phi(t), t, 2), N_M, P_M], [ddphi, N_M_expr, P_M_expr]) %[output:0560f1d4]

% 确保左手边不是 0，而是 I_M * ddphi
%[text] 求解出非线性系统表达式
% 统一替换为代数形式
FinalEqs = subs([Eq_wheel, Eq3_pendulum, Eq3_body], old_tot, new_tot) %[output:899d157a]

% 求解加速度闭式解
sol_acc = solve(FinalEqs, [ddx, ddtheta, ddphi]) %[output:51523f70]

% 提取并化简结果c
ddx_final = simplify(sol_acc.ddx) %[output:071e3572]
ddtheta_final = simplify(sol_acc.ddtheta) %[output:63b30476]
ddphi_final = simplify(sol_acc.ddphi) %[output:390446b2]
%[text] 线性化
%% 1. 定义线性化所需的符号变量
% 定义纯代数符号，用于替换表达式中的时间函数和微分项
syms theta_s dtheta_s x_s dx_s phi_s dphi_s T_s TP_s

% 建立映射列表：将 t 的函数映射到代数符号
old_states = [theta(t), diff(theta(t),t), x(t), diff(x(t),t), phi(t), diff(phi(t),t), T, T_P];
new_states = [theta_s,  dtheta_s,         x_s,  dx_s,          phi_s,  dphi_s,          T_s, TP_s];

%% 2. 构造非线性状态方程组 f(x, u)
% 首先将加速度结果转换为纯代数形式
ddx_alg = subs(ddx_final, old_states, new_states);
ddtheta_alg = subs(ddtheta_final, old_states, new_states);
ddphi_alg = subs(ddphi_final, old_states, new_states);

% 构造 f 向量 (注意顺序必须与状态向量一致)
% f = [theta_dot; theta_ddot; x_dot; x_ddot; phi_dot; phi_ddot]
f = [dtheta_s;    ... % x1_dot = x2
     ddtheta_alg; ... % x2_dot = theta_ddot
     dx_s;        ... % x3_dot = x4
     ddx_alg;     ... % x4_dot = x_ddot
     dphi_s;      ... % x5_dot = x6
     ddphi_alg];     % x6_dot = phi_ddot

% 明确状态向量和输入向量
state_vars = [theta_s, dtheta_s, x_s, dx_s, phi_s, dphi_s];
input_vars = [T_s, TP_s];

%% 3. 计算雅可比矩阵 (线性化)
A_sym = jacobian(f, state_vars) %[output:97c230bd]
B_sym = jacobian(f, input_vars) %[output:43ed4cb1]

%% 4. 在平衡点处求值
% 定义垂直向上平衡点：角度为0，速度为0，输入为0
% 注意：x_s (位置) 通常设为 0，因为动力学通常与绝对位置无关
eq_point = [0, 0, 0, 0, 0, 0, 0, 0] %[output:9feb5872]
A_linear = simplify(subs(A_sym, [state_vars, input_vars], eq_point));
B_linear = simplify(subs(B_sym, [state_vars, input_vars], eq_point));

% 显示结果
disp('线性化后的状态矩阵 A:'); %[output:53618f55]
disp(A_linear); %[output:7281d61c]
disp('线性化后的控制矩阵 B:'); %[output:5023fad8]
disp(B_linear); %[output:5287339f]

%% 5. (可选) 带入物理参数得到数值矩阵
% 请根据你的实际参数修改下方数值
params = [M, m_P, m_wheel, L, L_M, l, g, I_P, I_M, I_wheel, R];
values = [5, 1,   0.5,     0.4, 0.2, 0.3, 9.8, 0.02, 0.05, 0.01, 0.1]; 

A_num = double(subs(A_linear, params, values));
B_num = double(subs(B_linear, params, values));

disp('数值 A 矩阵:'); %[output:98316014]
disp(A_num); %[output:00be7017]

